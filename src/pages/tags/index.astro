---
import Base from '../../layouts/Base.astro';
import { getPublishedKnowledge, url } from '../../lib/knowledge';

const entries = await getPublishedKnowledge();
const counts = new Map<string, number>();
for (const e of entries) for (const t of e.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'));
---

<Base title="タグ一覧">
  <h1>タグ一覧</h1>
  {
    tags.length > 0 ? (
      <div class="chips">
        {tags.map(([t, n]) => (
          <a class="chip" href={url(`/tags/${encodeURIComponent(t)}/`)}>#{t}（{n}）</a>
        ))}
      </div>
    ) : (
      <p class="muted">まだタグがありません。</p>
    )
  }
</Base>
